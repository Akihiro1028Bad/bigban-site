# 値に空白・記号(< > | ( ) & 等)を含む場合は必ずダブルクォートで囲むこと。
# 未クォートだと `set -a; source .env` がシンタックスエラーで落ちる(例: RESEND_FROM)。
# アプリ本体は dotenv で読むため動くが、疎通確認の shell スクリプト等で破綻するため統一する。

# 本番URL (sitemap.xml / robots.txt / OGP の metadataBase に使用)
# Vercel の production 環境変数にも同値を設定してください
NEXT_PUBLIC_SITE_URL=https://www.thepicklebang.com

# メンテナンスモード (teaser ページにリダイレクトする)
NEXT_PUBLIC_MAINTENANCE=false

# Resend (お問い合わせフォームのメール送信)
RESEND_API_KEY=
# 表示名付き差出人は空白・記号を含むので必ずクォートする
RESEND_FROM="THE PICKLE BANG THEORY <onboarding@resend.dev>"
CONTACT_TO_EMAIL=

# microCMS (ニュース CMS)
# サービス名 (https://${MICROCMS_SERVICE_DOMAIN}.microcms.io の部分)
MICROCMS_SERVICE_DOMAIN=
# 読み取り API キー (Vercel Production 環境変数に設定)
MICROCMS_API_KEY=
# Webhook 署名検証用シークレット (microCMS 管理画面 > API > Webhook で設定したものと一致させる)
MICROCMS_WEBHOOK_SECRET=
# プレビュー入口 (/api/draft/enable) の secret パラメータ検証用
MICROCMS_DRAFT_SECRET=
# (任意) プレビュー入口の Origin allowlist (カンマ区切り、未設定で全許可)
MICROCMS_DRAFT_ALLOWED_ORIGINS=

# CMS ニュース機能フラグ (true で有効化、それ以外は旧ハードコード表示)
USE_CMS_NEWS=false

# ───────────────────────────────────────────────
# Growth loop (GA4 / Search Console データ取得・OAuth)
# 自宅 Windows PC でのみ設定。値はリポジトリにコミットしないこと。
# 取得手順は docs/superpowers/plans/2026-06-12-growth-loop-data-fetch.md 参照
# ───────────────────────────────────────────────
# GA4 プロパティ ID (管理 > プロパティの詳細の数値)
GROWTH_GA4_PROPERTY_ID=540956661
# Search Console のプロパティ (登録した文字列と完全一致。URL プレフィックス型は末尾スラッシュ込み)
GROWTH_GSC_SITE_URL=https://www.thepicklebang.com/
# OAuth デスクトップアプリのクライアント情報 (Google Cloud Console で発行)
GROWTH_GOOGLE_CLIENT_ID=
GROWTH_GOOGLE_CLIENT_SECRET=
# 一度きりの同意で取得するリフレッシュトークン (npm run growth:setup-token で取得)
GROWTH_GOOGLE_REFRESH_TOKEN=
# (任意) リフレッシュトークンの失効予定 (ISO 文字列 or epoch ミリ秒)。
# OAuth 同意画面が「テスト」だと付与から7日で失効するため、発行日+7日を設定すると
# 失効30日前から LINE 通知に警告が出る。本番公開(無期限)なら未設定でよい。
# 例: GROWTH_GOOGLE_TOKEN_EXPIRES_AT=2026-06-23T00:00:00+09:00
GROWTH_GOOGLE_TOKEN_EXPIRES_AT=
# セルフチューニングループ(学習ログ)DB の data source ID(Notion 管理画面で作成後に設定)。
# 未設定なら学習ログ追記は静かにスキップ(本処理は止まらない・SI1)。
GROWTH_LEARNING_LOG_DS=
# (任意) 週次(ネタ出し)モードのモデル。未設定なら claude-opus-4-8。
GROWTH_WEEKLY_MODEL=
# (任意) headless 実行 agent。未設定/claude=従来どおり Claude、codex=Codex CLI で実行。
# Codex はまず growth:advise-loop / growth:decorate-loop の小さい pull 型ループで検証する。
GROWTH_AGENT=
# (任意) Codex CLI 用。GROWTH_AGENT=codex の時だけ使う。
GROWTH_CODEX_APPROVAL=
# 既定は workspace-write。Codex 内で tsx IPC / Notion fetch が塞がる場合のみ検証用に danger-full-access。
GROWTH_CODEX_SANDBOX=
GROWTH_CODEX_MODEL=
# (任意) daemon に下書き自動生成を追加する。1 の時だけ承認済み/生成中かつ下書きID未作成を
# 軽量 peek し、対象がある時だけ growth:drafts を起動する。
GROWTH_DRAFTS_AUTO=
# (任意) 下書き自動生成の監視間隔(ms)。未設定なら 300000(5分)。
GROWTH_DAEMON_DRAFTS_EVERY_MS=
# (任意) GA4 keyEvents 設定完了日(YYYY-MM-DD)。未設定なら CV は未計測扱い。
GROWTH_GA4_KEYEVENTS_SINCE=
# コンテンツのアイキャッチ/本文画像生成 (openai-image-gen スキル・gpt-image-2)
OPENAI_API_KEY=
# microCMS メディアアップロード (アイキャッチ自動添付・管理API)
# サービスID (https://${MICROCMS_SERVICE_DOMAIN}.microcms.io の部分。例: thepicklebang)
MICROCMS_SERVICE_DOMAIN=
# 管理APIキー (メディアアップロード権限が必要)
MICROCMS_MANAGEMENT_API_KEY=
# (任意) コンテンツ書き込み専用キー。未設定なら MICROCMS_MANAGEMENT_API_KEY を流用
# 下書きの作成/更新 (growth:draft-content) に使用。content の POST/PATCH 権限が必要
MICROCMS_CONTENT_API_KEY=

# ───────────────────────────────────────────────
# Growth loop 週次 LINE 通知 + 承認ページ
# 設定手順は docs/operations/growth-line-approval-setup.md 参照
# ───────────────────────────────────────────────
# LINE Messaging API のチャネルアクセストークン (グループへ push 送信)
LINE_CHANNEL_ACCESS_TOKEN=
# 通知先グループの ID (Bot をグループに招待し webhook イベントから取得)
LINE_GROUP_ID=
# LINE push の送信範囲。未設定/weekly-only=週次完了と週次失敗のみ、all=全通知を送信
GROWTH_NOTIFY_LEVEL=
# 公開した「週次グロースレポート」DB の notion.site ドメイン (例: pickle.notion.site)
# 設定すると通知に公開レポートURL(ログイン不要)を載せる
NOTION_PUBLIC_DOMAIN=
# Notion 内部インテグレーションのトークン (secret_...)。承認ページが施策提案/記事ネタ案DBを更新
# 取得後、対象2DBをこのインテグレーションに Connect すること
NOTION_TOKEN=
# Worker 可視化 / 運用ログ DB
GROWTH_WORKER_LOG_DS=
GROWTH_WORKER_ID=
# 承認画面の合言葉認証(フェイルセーフ: 既定ON)。
# 未設定なら本番でも自動的に認証ON。ローカル開発で合言葉ゲートを外したいときだけ false にする。
# 本番(Vercel production)で false にするとデプロイ前ガード(scripts/check-prod-auth.mjs)が失敗する。
APPROVE_AUTH_ENABLED=
# 承認ページの合言葉。承認画面でこの文字列を入力した人だけが承認/却下できる
# (URL にトークンは載せず、画面で入力する方式)。例: ビックマン
# 注意: 短く推測しやすい語はブルートフォースに弱い。社外秘で、信頼できる人にだけ共有する
APPROVE_SECRET=
