# 環境変数テンプレート
# 値に空白・記号(< > | ( ) & 等)を含む場合はダブルクォートで囲むこと。
# 秘密値はコミットしないこと。

# =====================================================================
# 1. Vercel と Windows 常時稼働PCの両方に設定
# =====================================================================

NEXT_PUBLIC_SITE_URL=https://www.thepicklebang.com

# microCMS（両環境に同じ値。APIキーはserver-only）
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# コラムのmicroCMS公開先。columns分離後の本番は columns。
# 媒体=ニュースの記事はこの値に関係なく news を使う。
GROWTH_MICROCMS_ENDPOINT=columns

# Notion（両環境に同じ内部インテグレーショントークン）
NOTION_TOKEN=

# 承認画面の合言葉（VercelはAPI認証、Windowsは週次LINE通知に使用）
APPROVE_SECRET=

# 任意: 共通Notion DB。未設定時は対象機能をスキップまたはコード内既定値を使用。
GROWTH_LEARNING_LOG_DS=
GROWTH_WORKER_LOG_DS=
GROWTH_MODEL_SETTINGS_DS=

# =====================================================================
# 2. Vercel Production のみに設定
# =====================================================================

# サイト表示
NEXT_PUBLIC_MAINTENANCE=false
GOOGLE_SITE_VERIFICATION=

# お問い合わせ・メール登録（使用する場合は3項目とも設定）
RESEND_API_KEY=
RESEND_FROM="THE PICKLE BANG THEORY <onboarding@resend.dev>"
CONTACT_TO_EMAIL=

# microCMS Webhook・プレビュー
MICROCMS_WEBHOOK_SECRET=
MICROCMS_DRAFT_SECRET=
# 任意: カンマ区切りのOrigin allowlist
MICROCMS_DRAFT_ALLOWED_ORIGINS=

# CMS公開フラグ
USE_CMS_NEWS=false
USE_CMS_COLUMNS=false

# 承認画面認証。未設定でもONだが、本番では true の明示を推奨。falseは禁止。
APPROVE_AUTH_ENABLED=true

# =====================================================================
# 3. Windows 常時稼働PC のみに設定
# =====================================================================

# GA4 / Search Console
GROWTH_GA4_PROPERTY_ID=540956661
GROWTH_GSC_SITE_URL=https://www.thepicklebang.com/
GROWTH_GOOGLE_CLIENT_ID=
GROWTH_GOOGLE_CLIENT_SECRET=
GROWTH_GOOGLE_REFRESH_TOKEN=
# 任意: OAuth同意画面がテスト状態の場合の失効予定
GROWTH_GOOGLE_TOKEN_EXPIRES_AT=
# 任意: CTA keyEvents計測開始日 YYYY-MM-DD（記事公開日ではなくレポート期間との重なり判定に使用）
GROWTH_GA4_KEYEVENTS_SINCE=

# 公開週次レポートの notion.site ドメイン
NOTION_PUBLIC_DOMAIN=

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_GROUP_ID=
# 未設定/weekly-only=週次中心、all=全通知
GROWTH_NOTIFY_LEVEL=

# 画像生成
OPENAI_API_KEY=

# Worker識別子（未設定時はPCのhostname）
GROWTH_WORKER_ID=windows-home-worker

# daemon: 未設定で下書き・施策を自動検知。止める場合だけ 0。
GROWTH_DRAFTS_AUTO=
GROWTH_INITIATIVES_AUTO=

# daemon間隔の任意上書き（ms）
GROWTH_DAEMON_PULL_EVERY_MS=
GROWTH_DAEMON_DRAFTS_EVERY_MS=
GROWTH_DAEMON_INITIATIVES_EVERY_MS=
GROWTH_DAEMON_PUBLISH_EVERY_MS=
GROWTH_DAEMON_STALL_EVERY_MS=
GROWTH_DAEMON_METRICS_EVERY_MS=
GROWTH_DAEMON_REVIEW_EVERY_MS=

# subprocess timeout / lease（ms、未設定または正の有限値でない場合は既定値）
GROWTH_TIMEOUT_CONTROL_MS=
GROWTH_TIMEOUT_PULL_LOOP_MS=
GROWTH_TIMEOUT_WEEKLY_MS=
GROWTH_TIMEOUT_INITIATIVES_MS=
GROWTH_TIMEOUT_IMAGE_PROMPT_MS=
GROWTH_TIMEOUT_DRAFTS_MS=
GROWTH_TIMEOUT_DRAFT_RESEARCH_MS=
GROWTH_TIMEOUT_DRAFT_WRITE_MS=
GROWTH_TIMEOUT_PUBLISH_DRAFT_MS=
GROWTH_TIMEOUT_DAEMON_DATA_MS=
GROWTH_KILL_GRACE_MS=
GROWTH_LOCK_HEARTBEAT_MS=
GROWTH_LOCK_LEASE_MS=
GROWTH_DAEMON_HEARTBEAT_MS=

# AI実行制御。プロバイダー・モデル・推論強度は承認画面「AIモデル」で設定。
GROWTH_CODEX_APPROVAL=
GROWTH_CODEX_SANDBOX=
GROWTH_MODEL_SETTINGS_DISABLE=

# その他の任意設定
GROWTH_REVISE_DAILY_CAP=
GROWTH_NOTIFY_WINDOW_MS=
GROWTH_MICROCMS_TIMEOUT_MS=
GROWTH_MICROCMS_MAX_ATTEMPTS=
# 正規化済み予約CSV（絶対パス）。未設定時は実予約を欠損として記録する。
GROWTH_RESERVATION_CSV_PATH=
# 任意: CSV収録範囲sidecarの絶対パス。未設定時は <CSVパス>.coverage.json。
GROWTH_RESERVATION_COVERAGE_PATH=
