# 環境変数テンプレート
# 値に空白・記号(< > | ( ) & 等)を含む場合はダブルクォートで囲むこと。
# 秘密値はコミットしないこと。

# =====================================================================
# 1. Vercel に設定
# =====================================================================

NEXT_PUBLIC_SITE_URL=https://www.thepicklebang.com

# microCMS（APIキーはserver-only）
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# サイト表示
NEXT_PUBLIC_MAINTENANCE=false
GOOGLE_SITE_VERIFICATION=

# お問い合わせ・メール登録（使用する場合は3項目とも設定）
RESEND_API_KEY=
RESEND_FROM="THE PICKLE BANG THEORY <onboarding@resend.dev>"
CONTACT_TO_EMAIL=

# microCMS Webhook・プレビュー
MICROCMS_WEBHOOK_SECRET=
MICROCMS_DRAFT_SECRET=
# 任意: カンマ区切りのOrigin allowlist
MICROCMS_DRAFT_ALLOWED_ORIGINS=

# CMS公開フラグ
USE_CMS_NEWS=false
USE_CMS_COLUMNS=false

# =====================================================================
# 2. ローカル(.env.local)のみ: 対話型分析セッション・画像生成CLI
#    (docs/operations/interactive-analysis-runbook.md)
# =====================================================================

# GA4 / Search Console（scripts/analytics/query.mjs が使用）
GROWTH_GA4_PROPERTY_ID=540956661
GROWTH_GSC_SITE_URL=https://www.thepicklebang.com/
GROWTH_GOOGLE_CLIENT_ID=
GROWTH_GOOGLE_CLIENT_SECRET=
GROWTH_GOOGLE_REFRESH_TOKEN=

# LINE友だち数の取得（任意・query.mjs が使用）
LINE_CHANNEL_ACCESS_TOKEN=

# 画像生成（growth:gen-eyecatch / growth:gen-body-image / growth:upload-media）
OPENAI_API_KEY=
GROWTH_MICROCMS_TIMEOUT_MS=
GROWTH_MICROCMS_MAX_ATTEMPTS=
